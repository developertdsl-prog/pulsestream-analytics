# PulseStream-Analytics Configuration
PORT=5000
NODE_ENV=production

# Persistence Tier
MONGODB_URI=mongodb://localhost:27017/pulsestream_analytics
REDIS_URL=redis://localhost:6379

# Streaming Engine Defaults
DEFAULT_WATERMARK_DELAY_MS=3000
MAX_BUFFER_CAPACITY=100000
BATCH_INGEST_LIMIT=5000
WINDOW_FLUSH_INTERVAL_MS=1000

# Security
STREAM_API_KEY=pulsestream_sec_token_9942
LOG_LEVEL=info
