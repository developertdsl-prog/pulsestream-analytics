{
  "name": "pulsestream-analytics",
  "version": "1.0.0",
  "description": "Distributed Real-Time Stream Analytics Engine, Event-Time Processing, Tumbling & Sliding Window Aggregation, Watermarking & CEP Pattern Detection",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "npm start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "node server/utils/seedPipelines.js",
    "test": "jest --detectOpenHandles --runInBand",
    "lint": "eslint server/**/*.js client/src/**/*.{js,jsx}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/developertdsl-prog/pulsestream-analytics.git"
  },
  "keywords": [
    "stream-processing",
    "real-time-analytics",
    "event-time",
    "watermarking",
    "tumbling-windows",
    "sliding-windows",
    "complex-event-processing",
    "dead-letter-queue"
  ],
  "author": "developertdsl-prog <developer.tdsl@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.2",
    "supertest": "^7.0.0"
  }
}
